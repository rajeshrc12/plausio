generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileStatus {
  INIT
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  genre       String
  director    String
  actor       String
  language    String
  year        Int

  views    Int @default(0)
  duration Int

  fileStatus FileStatus @default(INIT)
  fileType   String
  filesize   Int
  filename   String

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  thumbnail Thumbnail?
  cover     Cover?
}

model Thumbnail {
  id   Int    @id @default(autoincrement())
  name String
  size Int
  type String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movieId Int   @unique
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Cover {
  id   Int    @id @default(autoincrement())
  name String
  size Int
  type String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movieId Int   @unique
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}
